# Secrets only — URLs live in config/environments.js
# Prefix with env name when values differ per env, e.g. DEV_USER_PASSWORD / UAT_USER_PASSWORD

# ── User Portal accounts (email / password), all without 2FA ──
# USER_*        = DLT company (same company as DLT_HUID), used by tests/auth.setup.js
# NORMAL_USER_* = normal company (no is_dlt), TSD_USER_* = TSD company (no is_dlt)
# DLT_B_USER_*  = optional second DLT company (company B), for TS01-TC04
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
DEV_NORMAL_USER_EMAIL=
DEV_NORMAL_USER_PASSWORD=
DEV_TSD_USER_EMAIL=
DEV_TSD_USER_PASSWORD=
DEV_DLT_B_USER_EMAIL=
DEV_DLT_B_USER_PASSWORD=

UAT_USER_EMAIL=
UAT_USER_PASSWORD=
UAT_NORMAL_USER_EMAIL=
UAT_NORMAL_USER_PASSWORD=
UAT_TSD_USER_EMAIL=
UAT_TSD_USER_PASSWORD=
UAT_DLT_B_USER_EMAIL=
UAT_DLT_B_USER_PASSWORD=

# ── Public API HMAC key pairs (huid / secret key), ask BE ──
# DLT_*     = DLT company, used by Create Future Items
# DLT_B_*   = optional second DLT company (company B), creates its items for TS01-TC04
# NON_DLT_* = optional non-DLT customer, for the "credential is not DLT" test
DEV_DLT_HUID=
DEV_DLT_SECRET_KEY=
DEV_DLT_B_HUID=
DEV_DLT_B_SECRET_KEY=
DEV_NON_DLT_HUID=
DEV_NON_DLT_SECRET_KEY=

UAT_DLT_HUID=
UAT_DLT_SECRET_KEY=
UAT_DLT_B_HUID=
UAT_DLT_B_SECRET_KEY=
UAT_NON_DLT_HUID=
UAT_NON_DLT_SECRET_KEY=

# ── EOD payment reconcile: S3 folder of the bank EOD files, ask BE; only used by npm run test:eod ──
DEV_EOD_S3_REGION=
DEV_EOD_S3_BUCKET=
DEV_EOD_S3_PREFIX=
DEV_EOD_S3_ACCESS_KEY_ID=
DEV_EOD_S3_SECRET_ACCESS_KEY=
DEV_EOD_COMPANY_ACCOUNT=
