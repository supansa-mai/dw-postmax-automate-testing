# Secrets only — URLs live in config/environments.js
# Prefix with env name when values differ per env, e.g. DEV_USER_PASSWORD / UAT_USER_PASSWORD
# USER_* = User Portal account of the DLT company (same company as the DLT HUID below), without 2FA
DEV_USER_EMAIL=
DEV_USER_PASSWORD=
UAT_USER_EMAIL=
UAT_USER_PASSWORD=
# NORMAL_USER_* / TSD_USER_* = User Portal accounts without is_dlt (normal company / TSD company), without 2FA
DEV_NORMAL_USER_EMAIL=
DEV_NORMAL_USER_PASSWORD=
DEV_TSD_USER_EMAIL=
DEV_TSD_USER_PASSWORD=
UAT_NORMAL_USER_EMAIL=
UAT_NORMAL_USER_PASSWORD=
UAT_TSD_USER_EMAIL=
UAT_TSD_USER_PASSWORD=

# Public API HMAC credentials (Create Future Items) — ask BE for the DLT key pair of each env
DEV_DLT_HUID=
DEV_DLT_SECRET_KEY=
UAT_DLT_HUID=
UAT_DLT_SECRET_KEY=
# Optional: non-DLT Public API key pair, for the "credential is not DLT" test
DEV_NON_DLT_HUID=
DEV_NON_DLT_SECRET_KEY=
